{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "RitualDev Enterprise Governance Compliance Engine",
          "version": "3.0.0",
          "informationUri": "https://ritualdev.in/enterprise",
          "rules": [
            {
              "id": "SOC2-CC6.1",
              "name": "Logical Access & IMDSv2 Hardened Node Isolation",
              "shortDescription": {
                "text": "Logical Access & IMDSv2 Hardened Node Isolation"
              },
              "fullDescription": {
                "text": "Enforces strict IAM boundary isolation, IMDSv2 hop limit 1, and SCIM 2.0 automated provisioning / instant deprovisioning."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#soc2-cc6.1"
            },
            {
              "id": "SOC2-CC6.6",
              "name": "Logical Boundaries & Encryption in Transit / Memory",
              "shortDescription": {
                "text": "Logical Boundaries & Encryption in Transit / Memory"
              },
              "fullDescription": {
                "text": "All sensitive credentials and prompts are encrypted in transit via TLS 1.3 and held exclusively in ephemeral WebCrypto AES-256-GCM memory vaults."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#soc2-cc6.6"
            },
            {
              "id": "SOC2-CC6.8",
              "name": "Malicious Code & Unauthorized Agent Subshell Prevention",
              "shortDescription": {
                "text": "Malicious Code & Unauthorized Agent Subshell Prevention"
              },
              "fullDescription": {
                "text": "Autonomous agent execution is confined via eBPF wire proxies, subshell syscall filters, and AST static taint analysis."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#soc2-cc6.8"
            },
            {
              "id": "SOC2-CC7.2",
              "name": "Tamper-Evident Hash-Chained Audit Trails & SIEM Export",
              "shortDescription": {
                "text": "Tamper-Evident Hash-Chained Audit Trails & SIEM Export"
              },
              "fullDescription": {
                "text": "All agent modifications and DLP blocks are recorded in an HMAC-SHA256 append-only ledger and forwarded to Splunk, Datadog, or Microsoft Sentinel."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#soc2-cc7.2"
            },
            {
              "id": "ISO27001-8.28",
              "name": "Secure Coding & Cryptographic AST Vulnerability Analysis",
              "shortDescription": {
                "text": "Secure Coding & Cryptographic AST Vulnerability Analysis"
              },
              "fullDescription": {
                "text": "Continuous static code analysis identifying injection flaws, secret leaks, and insecure dependencies with deterministic OASIS SARIF v2.1.0 fingerprinting."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#iso27001-8.28"
            },
            {
              "id": "ISO27001-8.7",
              "name": "Protection Against Malware & Autonomous Execution Containment",
              "shortDescription": {
                "text": "Protection Against Malware & Autonomous Execution Containment"
              },
              "fullDescription": {
                "text": "Prevents untrusted agent tool modifications from propagating to production without Proof-of-Intent verification."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#iso27001-8.7"
            },
            {
              "id": "ISO27001-8.16",
              "name": "Monitoring Activities & Cryptographic Integrity Verification",
              "shortDescription": {
                "text": "Monitoring Activities & Cryptographic Integrity Verification"
              },
              "fullDescription": {
                "text": "Maintains immutable event records protected by HMAC signatures to guarantee non-repudiation."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#iso27001-8.16"
            },
            {
              "id": "ISO27001-8.24",
              "name": "Cryptographic Access Tokens & Timing-Safe Verification",
              "shortDescription": {
                "text": "Cryptographic Access Tokens & Timing-Safe Verification"
              },
              "fullDescription": {
                "text": "Enforces PASETO v4.local capability tokens for offline sub-0.2ms authorization and constant-time HMAC webhook verification."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#iso27001-8.24"
            },
            {
              "id": "EU-AI-ACT-ART10",
              "name": "Data Governance & Data Minimization for AI Pipelines",
              "shortDescription": {
                "text": "Data Governance & Data Minimization for AI Pipelines"
              },
              "fullDescription": {
                "text": "Prevents training data leakage and unauthorized enterprise context capture via client-side format-preserving surrogate masking."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#eu-ai-act-art10"
            },
            {
              "id": "EU-AI-ACT-ART14",
              "name": "Human Oversight & Fail-Safe Execution Interception",
              "shortDescription": {
                "text": "Human Oversight & Fail-Safe Execution Interception"
              },
              "fullDescription": {
                "text": "Requires human-in-the-loop review and deterministic Proof-of-Intent approval before irreversible state mutations occur."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#eu-ai-act-art14"
            },
            {
              "id": "EU-AI-ACT-ART15",
              "name": "Cybersecurity, Accuracy & Adversarial Robustness Attestation",
              "shortDescription": {
                "text": "Cybersecurity, Accuracy & Adversarial Robustness Attestation"
              },
              "fullDescription": {
                "text": "Protects AI systems against prompt injection, jailbreaks, data poisoning, and model evasion attacks via continuous adversarial fuzzing."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#eu-ai-act-art15"
            },
            {
              "id": "DPDP-GDPR-MINIMIZATION",
              "name": "Zero-Knowledge Data Minimization & PII Redaction",
              "shortDescription": {
                "text": "Zero-Knowledge Data Minimization & PII Redaction"
              },
              "fullDescription": {
                "text": "Strict client-side redaction of Aadhaar, PAN, SSN, and financial records prior to cloud egress, with zero plaintext persistence."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#dpdp-gdpr-minimization"
            },
            {
              "id": "DPDP-GDPR-CRYPTOGRAPHIC-PROOF",
              "name": "Mathematical Re-Identification Risk Bounds & Erasure Proofs",
              "shortDescription": {
                "text": "Mathematical Re-Identification Risk Bounds & Erasure Proofs"
              },
              "fullDescription": {
                "text": "Guarantees ε-differential privacy bounds and produces cryptographic audit receipts for regulatory data erasure inquiries."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "helpUri": "https://ritualdev.in/trust#dpdp-gdpr-cryptographic-proof"
            }
          ]
        }
      },
